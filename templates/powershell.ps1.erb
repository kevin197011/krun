# Error handling
$ErrorActionPreference = 'Stop'

# Usage:
# powershell -ExecutionPolicy Bypass -File <%= @action %>_<%= @name %>.ps1
# .\<%= @action %>_<%= @name %>.ps1
# .\<%= @action %>_<%= @name %>.ps1 -Force
#
# Remote exec:
# irm https://raw.githubusercontent.com/kevin197011/krun/main/lib/ps1/<%= @action %>_<%= @name %>.ps1 | iex
# $env:FORCE_INSTALL='true'; irm https://raw.githubusercontent.com/kevin197011/krun/main/lib/ps1/<%= @action %>_<%= @name %>.ps1 | iex
#
# idempotent: check state before each change; safe to re-run

# Description: <%= @action %> <%= @name %> (Windows)

# Parse arguments manually for irm | iex support
$Force = $false
if ($args -contains "-Force" -or $args -contains "-force") {
    $Force = $true
}
if ($env:FORCE_INSTALL -eq 'true') {
    $Force = $true
}

class ScriptRunner {
    [bool] $Force = $false

    [bool] IsAdmin() {
        $currentPrincipal = [Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()
        return $currentPrincipal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    }

    [bool] IsDone() {
        # TODO: return $true when already applied (idempotent skip)
        return $false
    }

    [void] Apply() {
        Write-Host "Applying <%= @action %>_<%= @name %>..." -ForegroundColor Cyan
        # TODO: implement
        Write-Host "<%= @action %>_<%= @name %> done." -ForegroundColor Green
    }

    [void] Run() {
        # Uncomment when Administrator is required:
        # if (-not $this.IsAdmin()) {
        #     throw "Administrator privileges required. Re-run PowerShell as Administrator."
        # }

        if ($this.IsDone() -and -not $this.Force) {
            Write-Host "<%= @action %>_<%= @name %> already applied. Use -Force to re-run." -ForegroundColor Yellow
            return
        }

        $this.Apply()
    }
}

# Main execution
$runner = [ScriptRunner]::new()
$runner.Force = $Force
$runner.Run()
